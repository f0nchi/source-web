---
import Nav from '../../components/Nav.astro';

// Texto crudo por slug: la bajada de cada ensayo es su primer párrafo real, nunca un resumen inventado.
const rawEnsayos = Object.fromEntries(
    Object.entries(import.meta.glob('../../ensayos/*.md', { query: '?raw', import: 'default', eager: true }))
        .map(([path, raw]) => [path.split('/').pop()?.replace(/\.md$/, '') || '', raw as string])
);

const ensayos = Object.entries(import.meta.glob('../../ensayos/*.md', { eager: true }))
    .map(([path, ensayo]: [string, any]) => {
        const slug = path.split('/').pop()?.replace(/\.md$/, '') || '';
        const cuerpoPlano = (rawEnsayos[slug] || '')
            .replace(/^---[\s\S]*?---/, '')
            .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
            .replace(/[#>*_`]/g, '')
            .trim();
        const bajada = (cuerpoPlano.split(/\n\s*\n/)[0] || '').replace(/\s+/g, ' ').trim();
        return { ...ensayo, slug, bajada };
    })
    .sort((a, b) => new Date(b.frontmatter?.date).valueOf() - new Date(a.frontmatter?.date).valueOf());
---

<!DOCTYPE html>
<html lang="es-AR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ensayos · Fonchi Fontecoba</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Spectral:ital,wght@0,200;0,300;0,400;0,600;1,300&display=swap" rel="stylesheet">
    <meta name="description" content="Los ensayos de Fonchi Fontecoba: la lectura de lo que se abre cuando las personas trabajan a través de la IA, escrita desde adentro de la construcción." />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://www.fonchi.com.ar/ensayos/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fonchi Fontecoba" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content="Ensayos · Fonchi Fontecoba" />
    <meta property="og:description" content="Los ensayos con firma de Fonchi Fontecoba: lo que se abre cuando las personas trabajan a través de la IA." />
    <meta property="og:url" content="https://www.fonchi.com.ar/ensayos/" />
    <meta property="og:image" content="https://www.fonchi.com.ar/og-registro.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="fonchi.com.ar: lo que aprendo construyendo sistemas que trabajan a través de la IA." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://www.fonchi.com.ar/og-registro.png" />
    <meta name="twitter:title" content="Ensayos · Fonchi Fontecoba" />
    <meta name="twitter:description" content="Los ensayos con firma de Fonchi Fontecoba: lo que se abre cuando las personas trabajan a través de la IA." />
</head>
<body>
    <div class="system-hud">
        [HOST: FONCHI] || [LAYER: ENSAYO] || [FIRMA: FONCHI_FONTECOBA]
    </div>

    <main class="container">
        <Nav />

        <header class="cabecera">
            <h1>Ensayos</h1>
            <p>
                La lectura de lo que se abre cuando las personas trabajan a
                través de la IA, escrita desde adentro de la construcción y con
                firma. El registro técnico del día a día vive en
                <a href="/">SOURCE</a>.
            </p>
        </header>

        <div class="lista">
            {ensayos.map((e: any) => (
                <article class="item">
                    <p class="fecha">{e.frontmatter?.date}</p>
                    <h2><a href={`/ensayos/${e.slug}/`}>{e.frontmatter?.title}</a></h2>
                    <p class="bajada">{e.bajada}</p>
                </article>
            ))}
        </div>
    </main>
</body>
</html>

<style>
    :root {
        --negro-profundo: #0c0e0d;
        --negro-registro: #101311;
        --filete: #1d2320;
        --gris-tenue: #5a645d;
        --gris-medio: #8b948e;
        --gris-texto: #c4c9c5;
        --blanco-titular: #f7f5ec;
        --senal: #e5ac3a;
    }

    body {
        background: var(--negro-profundo);
        color: var(--gris-texto);
        font-family: 'Spectral', serif;
        margin: 0;
        line-height: 1.7;
    }

    .system-hud {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        color: var(--gris-tenue);
        padding: 14px 20px;
        border-bottom: 1px solid var(--filete);
        letter-spacing: 0.04em;
    }

    .container {
        max-width: 720px;
        margin: 0 auto;
        padding: 40px 20px 80px;
    }

    .cabecera h1 {
        font-family: 'Spectral', serif;
        font-weight: 200;
        font-size: 48px;
        color: var(--blanco-titular);
        margin: 28px 0 12px;
    }

    .cabecera p { font-size: 17px; color: var(--gris-medio); max-width: 560px; }

    .cabecera a {
        color: var(--senal);
        text-decoration: none;
        border-bottom: 1px solid var(--senal);
    }

    .lista { margin-top: 36px; }

    .item {
        background: var(--negro-registro);
        border: 1px solid var(--filete);
        padding: 24px 28px;
        margin-bottom: 14px;
    }

    .fecha {
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        color: var(--senal);
        margin: 0 0 6px;
    }

    .item h2 { margin: 0; font-weight: 300; font-size: 26px; }

    .item h2 a {
        color: var(--blanco-titular);
        text-decoration: none;
    }

    .item h2 a:hover { color: var(--senal); }

    .bajada {
        margin: 12px 0 0;
        font-size: 16px;
        color: var(--gris-texto);
        font-weight: 300;
        max-width: 560px;
    }
</style>
