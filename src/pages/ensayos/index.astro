---
import Medicion from '../../components/Medicion.astro';
import Nav from '../../components/Nav.astro';
import Pie from '../../components/Pie.astro';


// Texto crudo por slug: la bajada de cada ensayo es su primer párrafo real, nunca un resumen inventado.
const rawEnsayos = Object.fromEntries(
    Object.entries(import.meta.glob('../../ensayos/*.md', { query: '?raw', import: 'default', eager: true }))
        .map(([path, raw]) => [path.split('/').pop()?.replace(/\.md$/, '') || '', raw as string])
);

const ensayos = Object.entries(import.meta.glob('../../ensayos/*.md', { eager: true }))
    .map(([path, ensayo]: [string, any]) => {
        const slug = path.split('/').pop()?.replace(/\.md$/, '') || '';
        const cuerpoPlano = (rawEnsayos[slug] || '')
            .replace(/^---[\s\S]*?---/, '')
            .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
            .replace(/[#>*_`]/g, '')
            .trim();
        // Los dos primeros párrafos: el primero suele ser la línea con que Fonchi arranca.
        const bajada = cuerpoPlano.split(/\n\s*\n/).slice(0, 2).map((p) => p.replace(/\s+/g, ' ').trim()).filter(Boolean);
        return { ...ensayo, slug, bajada };
    })
    .sort((a, b) => new Date(b.frontmatter?.date).valueOf() - new Date(a.frontmatter?.date).valueOf());
---

<!DOCTYPE html>
<html lang="es-AR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ensayos · Fonchi Fontecoba</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Spectral:ital,wght@0,200;0,300;0,400;0,600;1,300&display=swap" rel="stylesheet">
    <meta name="description" content="Los ensayos de Fonchi Fontecoba: la lectura de lo que se abre cuando las personas trabajan a través de la IA, escrita desde adentro de la construcción." />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://www.fonchi.com.ar/ensayos/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fonchi Fontecoba" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content="Ensayos · Fonchi Fontecoba" />
    <meta property="og:description" content="Los ensayos con firma de Fonchi Fontecoba: lo que se abre cuando las personas trabajan a través de la IA." />
    <meta property="og:url" content="https://www.fonchi.com.ar/ensayos/" />
    <meta property="og:image" content="https://www.fonchi.com.ar/og-registro.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="fonchi.com.ar: lo que aprendo construyendo sistemas que trabajan a través de la IA." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://www.fonchi.com.ar/og-registro.png" />
    <meta name="twitter:title" content="Ensayos · Fonchi Fontecoba" />
    <meta name="twitter:description" content="Los ensayos con firma de Fonchi Fontecoba: lo que se abre cuando las personas trabajan a través de la IA." />
    <Medicion />
</head>
<body>
    <div class="system-hud">
        [HOST: FONCHI] || [LAYER: ENSAYO] || [FIRMA: FONCHI_FONTECOBA]
    </div>

    <main class="container">
        <Nav actual="pienso" />

        <header class="cabecera">
            <h1>Ensayos</h1>
            <p>
                Lo que pienso sobre trabajar a través de la IA. Lo que hice
                está en el <a href="/">registro</a>.
            </p>
        </header>

        <div class="lista">
            {ensayos.map((e: any, i: number) => (
                <article class="item">
                    <p class="fecha">&gt;&gt; ENSAYO_{String(ensayos.length - i).padStart(2, '0')} // {e.frontmatter?.date}</p>
                    <h2><a href={`/ensayos/${e.slug}/`}>{e.frontmatter?.title}</a></h2>
                    {e.bajada.map((p: string) => <p class="bajada">{p}</p>)}
                    <p class="seguir"><a href={`/ensayos/${e.slug}/`}>SEGUIR_LEYENDO &rarr;</a></p>
                </article>
            ))}
        </div>
        <Pie />
    </main>
</body>
</html>

<style>
    /* Misma piel que el registro: mismo ancho, mismos filetes, mismos tamaños. */
    :root {
        --negro-profundo: #0c0e0d;
        --negro-registro: #101311;
        --filete: #1d2320;
        --gris-tenue: #5a645d;
        --gris-medio: #959e98;
        --gris-texto: #e4e8e5;
        --blanco-titular: #ffffff;
        --senal: #e5ac3a;
    }

    * { box-sizing: border-box; }

    body {
        background: var(--negro-profundo);
        color: var(--gris-texto);
        font-family: 'Spectral', Georgia, serif;
        font-weight: 300;
        font-size: 17px;
        line-height: 1.68;
        margin: 0;
        -webkit-font-smoothing: antialiased;
    }

    .system-hud {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.14em;
        color: var(--senal);
        border-bottom: 1px solid var(--filete);
        padding: 10px 24px;
        background: rgba(12, 14, 13, 0.96);
        text-transform: uppercase;
        z-index: 100;
    }

    .container {
        max-width: 860px;
        margin: 0 auto;
        padding: 96px 28px 96px 28px;
    }

    .cabecera h1 {
        font-weight: 600;
        font-size: 44px;
        line-height: 1;
        letter-spacing: -0.03em;
        color: var(--blanco-titular);
        margin: 0 0 22px;
    }

    .cabecera p { margin: 0; color: var(--gris-medio); max-width: 680px; }

    .cabecera a,
    .seguir a {
        color: var(--senal);
        text-decoration: none;
    }

    .cabecera a { border-bottom: 1px solid var(--senal); }

    .lista { margin-top: 56px; }

    .item {
        border-top: 1px solid var(--filete);
        padding: 38px 0 30px 0;
    }

    .fecha,
    .seguir {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--senal);
    }

    .fecha { margin: 0 0 22px; }

    .item h2 {
        margin: 0 0 24px;
        font-weight: 200;
        font-size: 34px;
        line-height: 1.1;
        letter-spacing: -0.03em;
        text-wrap: pretty;
    }

    .item h2 a {
        color: var(--blanco-titular);
        text-decoration: none;
    }

    .item h2 a:hover,
    .seguir a:hover { color: var(--senal); text-decoration: underline; text-underline-offset: 0.25em; }

    .bajada {
        margin: 0 0 24px;
        max-width: 680px;
    }

    .seguir { margin: 0; font-size: 12px; }
</style>
