---
// SOURCE — Capa de Origen de Fonchi Fontecoba
const pageTitle = "SOURCE | Sys.Log";

// Extraemos los logs usando Vite nativo en lugar de Astro.glob para asegurar la compatibilidad estricta en Vercel
const rawLogs = Object.values(import.meta.glob('../logs/*.md', { eager: true }));
// Ordenamos de más nuevo a más viejo por fecha del frontmatter
const logs = rawLogs.sort((a, b: any) => new Date(b.frontmatter?.date).valueOf() - new Date((a as any).frontmatter?.date).valueOf());
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SOURCE // Fonchi</title>
    <!-- Agentic SEO: Schema Markup -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Fonchi Fontecoba",
      "jobTitle": "Arquitecto de Sistemas de Marca",
      "worksFor": {
        "@type": "Organization",
        "name": "Ideas Aumentadas"
      },
      "description": "Diseñando sistemas operativos para mentes complejas."
    }
    </script>
    <!-- Agentic Metadata -->
    <meta name="robots" content="index, follow">
    <meta name="description" content="SOURCE. Registro de sistema y arquitectura operativa.">
</head>
<body>
    <div class="system-hud">
        [SYS_TICK: {new Date().toISOString().split('T')[0]}] || [HOST: FONCHI] || [LAYER: SOURCE]
    </div>

    <div class="container">
        <header>
<pre class="ascii-art">
   _____  ____  _    _____   _____  ______ 
  / ____|/ __ \| |  | |  __ \ / ____||  ____|
 | (___ | |  | | |  | | |__) | |     | |__   
  \___ \| |  | | |  | |  _  /| |     |  __|  
  ____) | |__| | |__| | | \ \| |____ | |____ 
 |_____/ \____/ \____/|_|  \_\\_____||______|
==============================================</pre>
            <p class="subtitle">> SYS_LOG // Documentación de Arquitectura de Sistemas.<span class="cursor">_</span></p>
        </header>

        <section class="statement">
            <p class="code-comment">/* 
 * PARADIGMA: 
 * La resistencia no es un rasgo natural del ecosistema. 
 * Es información sobre un defecto de arquitectura. 
 * Construimos para delegar la ejecución mecánica a la máquina, 
 * liberando así nuestra capacidad pura de pensamiento.
 */</p>
        </section>

        <!-- El Log de operaciones Dinámico compilado desde Notion/Make -->
        <div class="log-grid">
            {logs.map((log: any, index) => {
                const entryId = String(logs.length - index).padStart(2, '0');
                const Content = log.default;
                return (
                <article class="node">
                    <span class="node-id">>> [ENTRY_{entryId}] :: {log.frontmatter?.status || 'UNKNOWN'} // {log.frontmatter?.date}</span>
                    <h2>> {log.frontmatter?.title}</h2>
                    <div class="node-content">
                        <Content />
                    </div>
                    <span class="eof">[EOF]</span>
                </article>
                );
            })}
        </div>

        <footer class="system-footer">
            <span class="eof-log">[ END_OF_LOGS ]</span>
            <div class="whois-block">
                <span class="prompt-line">&gt; execute whois_host.sh</span>
                <p>USER_ID: Fonchi Fontecoba</p>
                <p>ROLE: Arquitecto de Sistemas de Marca</p>
                <p>ACTIVE_NODE: Ideas Aumentadas</p>
                <p>MISSION: Diseñando sistemas operativos para mentes complejas.</p>
                <div class="action-menu">
                    <span class="dim-text">STATUS: EOF // Awaiting user input...</span>
                    <a href="#" id="init-comm-link" class="comm-link"><span class="menu-key">[Y]</span> INITIATE_MAIL_PROTOCOL <span class="cursor">_</span></a>
                </div>
            </div>
        </footer>
    </div>

    <script is:inline>
        // Obfuscate the email to avoid basic syntax scraping by spam bots
        const commLink = document.getElementById('init-comm-link');
        if (commLink) {
            commLink.addEventListener('click', function(e) {
                e.preventDefault();
                const user = 'hola'; // Cambia esto por tu usuario de email
                const domain = 'fonchi.com.ar'; // Cambia esto por tu dominio de email
                window.open('mailto:' + user + '@' + domain + '?subject=System%20Protocol%20Init', '_blank');
            });
        }
    </script>
</body>
</html>

<style>
    /* ASCII / Terminal Esthetic Absoluta */
    :root {
        --bg-color: #000000;
        --text-base: #B0B0B0;
        --accent: #FFB000; /* Ambar Fosforo Terminal */
        --dim: #444444;
        --font-mono: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace;
    }

    body {
        margin: 0;
        padding: 0;
        background-color: var(--bg-color);
        color: var(--text-base);
        font-family: var(--font-mono);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
    }

    .system-hud {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        font-size: 0.75rem;
        color: var(--accent);
        border-bottom: 1px dashed var(--dim);
        padding: 8px 20px;
        background: rgba(0, 0, 0, 0.95);
        text-transform: uppercase;
        z-index: 100;
        box-sizing: border-box;
    }

    .container {
        max-width: 760px;
        margin: 0 auto;
        padding: 100px 20px 60px 20px;
    }

    header {
        margin-bottom: 4rem;
    }

    .ascii-art {
        color: #FFFFFF;
        font-size: clamp(0.5rem, 1.5vw, 1rem); /* Escala en móviles */
        line-height: 1.15;
        margin: 0 0 1rem 0;
        text-shadow: 0 0 5px rgba(255, 255, 255, 0.3);
    }

    .subtitle {
        color: var(--accent);
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .cursor {
        display: inline-block;
        animation: blink 1s step-end infinite;
        background-color: var(--accent);
        color: var(--bg-color);
        padding: 0 4px;
        margin-left: 4px;
    }

    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }

    .statement {
        margin-bottom: 4rem;
    }

    .code-comment {
        color: var(--dim);
        font-size: 0.9rem;
        white-space: pre-wrap;
    }

    .log-grid {
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .node {
        border-top: 1px solid var(--dim);
        border-bottom: 1px solid var(--dim);
        padding: 2rem 0;
    }

    .node-id {
        font-size: 0.8rem;
        color: var(--accent);
        display: block;
        margin-bottom: 1.5rem;
    }

    .node h2 {
        font-size: 1.1rem;
        font-weight: normal;
        margin: 0 0 1rem 0;
        color: #FFFFFF;
        text-transform: uppercase;
    }

    /* Como Astro importa HTML desde Markdown nativo, formateamos sus etiquetas interiores */
    :global(.node-content p) {
        margin: 0 0 1.5rem 0;
        font-size: 0.95rem;
    }
    
    :global(.node-content ul) {
        color: #A0A0A0;
        font-size: 0.90rem;
        margin-bottom: 1.5rem;
        list-style-type: square;
    }

    :global(.node-content strong) {
        color: #FFFFFF;
        font-weight: normal;
        text-decoration: underline;
        text-decoration-color: var(--dim);
    }

    .eof {
        font-size: 0.75rem;
        color: var(--dim);
    }

    .system-footer {
        margin-top: 6rem;
        border-top: 1px dashed var(--dim);
        padding-top: 2rem;
        color: var(--dim);
    }

    .eof-log {
        display: block;
        margin-bottom: 2rem;
        font-size: 0.8rem;
    }

    .whois-block {
        background-color: rgba(0, 255, 65, 0.03);
        border: 1px solid rgba(0, 255, 65, 0.2);
        padding: 1.5rem;
    }

    .prompt-line {
        color: var(--accent);
        display: block;
        margin-bottom: 1rem;
    }

    .whois-block p {
        margin: 0 0 0.5rem 0;
        font-size: 0.9rem;
        color: #A0A0A0;
    }

    .action-menu {
        margin-top: 2rem;
        border-top: 1px dashed rgba(255, 176, 0, 0.2); /* Accent dim */
        padding-top: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    .dim-text {
        font-size: 0.8rem;
        color: var(--dim);
        font-style: italic;
    }

    .menu-key {
        color: #FFFFFF;
        font-weight: bold;
    }

    .comm-link {
        color: var(--accent);
        text-decoration: none;
        display: inline-block;
        transition: background-color 0.2s ease, color 0.2s ease;
        padding: 2px 4px;
        margin-left: -4px;
    }

    .comm-link:hover {
        background-color: var(--accent);
        color: var(--bg-color);
        outline: none;
    }

    .comm-link:hover .cursor {
        background-color: var(--bg-color);
        color: var(--accent);
    }
</style>
