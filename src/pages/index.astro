---
// Extraemos los logs usando Vite nativo en lugar de Astro.glob para asegurar la compatibilidad estricta en Vercel
const rawLogs = Object.entries(import.meta.glob('../logs/*.md', { eager: true }))
    .map(([path, log]: [string, any]) => ({
        ...log,
        slug: path.split('/').pop()?.replace(/\.md$/, '') || '',
    }));
// Ordenamos de más nuevo a más viejo por fecha del frontmatter
const logs = rawLogs.sort((a, b: any) => new Date(b.frontmatter?.date).valueOf() - new Date((a as any).frontmatter?.date).valueOf());
// La home muestra solo las últimas 10 entradas completas; el resto vive en /log/pagina/N/
const TAMANO_PAGINA = 10;
const logsHome = logs.slice(0, TAMANO_PAGINA);
const hayMasEntradas = logs.length > TAMANO_PAGINA;
const rangoInicio = TAMANO_PAGINA + 1;
const rangoFin = Math.min(TAMANO_PAGINA * 2, logs.length);
import VolverArriba from '../components/VolverArriba.astro';
import Nav, { SECCION_FIRMADA } from '../components/Nav.astro';
---

<!DOCTYPE html>
<html lang="es-AR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fonchi</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Google Fonts: Spectral & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Spectral:ital,wght@0,200;0,300;0,400;0,600;1,300&display=swap" rel="stylesheet">

    <!-- Grafo de entidad: persona, empresa y estándar -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://www.fonchi.com.ar/#person",
          "name": "Fonchi Fontecoba",
          "url": "https://www.fonchi.com.ar/",
          "image": "https://www.fonchi.com.ar/fonchi.jpg",
          "jobTitle": "Arquitecto de Sistemas de Marca",
          "description": "Fundador de Ideas Aumentadas. Codifica la inteligencia de personas y marcas para que la IA la opere. Autor del estándar abierto .contexto/.",
          "worksFor": [
            {
              "@type": "Organization",
              "@id": "https://www.ideasaumentadas.com.ar/#organization",
              "name": "Ideas Aumentadas",
              "url": "https://www.ideasaumentadas.com.ar",
              "founder": { "@id": "https://www.fonchi.com.ar/#person" }
            },
            {
              "@type": "Role",
              "roleName": "Gerente de Marketing",
              "worksFor": {
                "@type": "Organization",
                "name": "Orkos",
                "url": "https://orkos.tech"
              }
            }
          ],
          "homeLocation": { "@type": "Place", "name": "Buenos Aires, Argentina" },
          "knowsLanguage": ["es", "en"],
          "knowsAbout": [
            "codificación de identidad para inteligencia artificial",
            "brand codification for AI",
            "estrategia de marketing con IA",
            "arquitectura de sistemas de marca",
            "brand systems architecture",
            "sistemas operativos de marca",
            "ingeniería de marketing con agentes de IA",
            "marketing engineering",
            "SEO para búsqueda con inteligencia artificial",
            "estándares de contexto para agentes",
            "inteligencia del trabajo"
          ],
          "sameAs": [
            "https://www.linkedin.com/in/fonchi/",
            "https://www.ideasaumentadas.com.ar/fonchi",
            "https://github.com/f0nchi"
          ]
        },
        {
          "@type": "CreativeWork",
          "@id": "https://github.com/f0nchi/contexto-estandar#estandar",
          "name": "El estándar .contexto/",
          "description": "Convención abierta, en español, para codificar la inteligencia de trabajo de una persona o una marca en una carpeta de archivos de texto plano que cualquier IA puede leer y operar.",
          "url": "https://www.ideasaumentadas.com.ar/estandar",
          "license": "https://creativecommons.org/licenses/by/4.0/",
          "inLanguage": "es",
          "author": { "@id": "https://www.fonchi.com.ar/#person" }
        }
      ]
    }
    </script>
    <meta name="robots" content="index, follow">
    <meta name="description" content="El registro público de Fonchi Fontecoba, fundador de Ideas Aumentadas y autor del estándar abierto .contexto/: lo que aprende construyendo sistemas que piensan y trabajan con IA, entrada por entrada y con fecha.">
    <link rel="canonical" href="https://www.fonchi.com.ar/">
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fonchi Fontecoba" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content="Fonchi Fontecoba · el registro" />
    <meta property="og:description" content="El registro público de Fonchi Fontecoba, fundador de Ideas Aumentadas y autor del estándar abierto .contexto/: lo que aprende construyendo sistemas que piensan y trabajan con IA, entrada por entrada y con fecha." />
    <meta property="og:url" content="https://www.fonchi.com.ar/" />
    <meta property="og:image" content="https://www.fonchi.com.ar/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="fonchi.com.ar: lo que aprendo construyendo sistemas que piensan y trabajan con IA." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://www.fonchi.com.ar/og.png" />
    <meta name="twitter:title" content="Fonchi Fontecoba · el registro" />
    <meta name="twitter:description" content="El registro público de Fonchi Fontecoba, fundador de Ideas Aumentadas y autor del estándar abierto .contexto/: lo que aprende construyendo sistemas que piensan y trabajan con IA, entrada por entrada y con fecha." />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-MT4686P6');</script>
    <!-- End Google Tag Manager -->
</head>
<body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MT4686P6"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <div class="system-hud">
        [SYS_TICK: <span id="sys-tick"></span>] || [HOST: FONCHI] || [LAYER: SOURCE]
    </div>

    <script is:inline>
        document.getElementById('sys-tick').textContent = new Date().toISOString().split('T')[0];
    </script>

    <div class="container">
        <Nav />
        <header>
            <h1 class="visually-hidden">Fonchi Fontecoba</h1>
            <a href="/" class="brand-conjunto" aria-label="Ir al inicio">
                <svg viewBox="6 8 52 48" class="brand-signo" role="img" aria-label="fonchi">
                    <rect class="banda-signo" style="--i:0; --final-op:1.00;" x="28" y="8" width="30" height="4" fill="var(--senal)"></rect>
                    <rect class="banda-signo" style="--i:1; --final-op:1.00;" x="26" y="12" width="30" height="4" fill="var(--senal)"></rect>
                    <rect class="banda-signo" style="--i:2; --final-op:0.92;" x="24" y="16" width="8" height="4" fill="var(--senal)"></rect>
                    <rect class="banda-signo" style="--i:3; --final-op:0.84;" x="22" y="20" width="8" height="4" fill="var(--senal)"></rect>
                    <rect class="banda-signo" style="--i:4; --final-op:0.76;" x="20" y="24" width="8" height="4" fill="var(--senal)"></rect>
                    <rect class="banda-signo" style="--i:5; --final-op:0.68;" x="18" y="28" width="20" height="4" fill="var(--senal)"></rect>
                    <rect class="banda-signo" style="--i:6; --final-op:0.60;" x="16" y="32" width="20" height="4" fill="var(--senal)"></rect>
                    <rect class="banda-signo" style="--i:7; --final-op:0.52;" x="14" y="36" width="8" height="4" fill="var(--senal)"></rect>
                    <rect class="banda-signo" style="--i:8; --final-op:0.44;" x="12" y="40" width="8" height="4" fill="var(--senal)"></rect>
                    <rect class="banda-signo" style="--i:9; --final-op:0.36;" x="10" y="44" width="8" height="4" fill="var(--senal)"></rect>
                    <rect class="banda-signo" style="--i:10; --final-op:0.28;" x="8" y="48" width="8" height="4" fill="var(--senal)"></rect>
                    <rect class="banda-signo" style="--i:11; --final-op:0.20;" x="6" y="52" width="8" height="4" fill="var(--senal)"></rect>
                </svg>
                <span class="brand-wordmark">fonchi</span>
            </a>
            <p class="subtitle">SYS_LOG // LO_QUE_HICE, CON FECHA</p>
        </header>

        <!-- Ensayos: la capa con firma -->
        <div class="ensayos-block">
            <span class="node-id">&gt;&gt; {SECCION_FIRMADA} // LO_QUE_PIENSO</span>
            {Object.entries(import.meta.glob('../ensayos/*.md', { eager: true }))
                .map(([path, e]: [string, any]) => ({ ...e, slug: path.split('/').pop()?.replace(/\.md$/, '') || '' }))
                .sort((a, b) => new Date(b.frontmatter?.date).valueOf() - new Date(a.frontmatter?.date).valueOf())
                .map((e: any) => (
                <p class="ensayo-item"><a href={`/ensayos/${e.slug}/`}>{e.frontmatter?.title}</a> <span class="ensayo-fecha">{e.frontmatter?.date}</span></p>
            ))}
            <p class="ensayo-item"><a href="/ensayos/" class="ver-todos">VER_TODOS &rarr;</a></p>
        </div>

        <!-- El Log de operaciones Dinámico: últimas 10 entradas, numeración global -->
        <div class="log-grid">
            {logsHome.map((log: any, index) => {
                const entryId = String(logs.length - index).padStart(2, '0');
                const Content = log.default;
                return (
                <article class="node">
                    <span class="node-id">&gt;&gt; ENTRY_{entryId} // {log.frontmatter?.status || 'STATUS_OK'} // {log.frontmatter?.date}</span>
                    <h2><a href={`/log/${log.slug}/`}>{log.frontmatter?.title}</a></h2>
                    <div class="node-content">
                        <Content />
                    </div>
                    <span class="eof">[EOF]</span>
                </article>
                );
            })}
        </div>

        {hayMasEntradas && (
            <p class="paginacion-link">
                <a href="/log/pagina/2/">&gt;&gt; ENTRADAS_ANTERIORES ({rangoInicio}-{rangoFin}) &rarr;</a>
            </p>
        )}

        <footer class="system-footer">
            <span class="eof-log">[ END_OF_LOGS ]</span>
            <div class="whois-block" id="contacto">
                <span class="prompt-line">&gt; execute whois_host.sh</span>
                <p>USER_ID: Fonchi Fontecoba</p>
                <p>ROLE: Arquitecto de Sistemas de Marca</p>
                <p>ACTIVE_NODE: Ideas Aumentadas</p>
                <p>MISSION: Diseñando sistemas operativos para mentes complejas.</p>
                <div class="action-menu">
                    <span class="dim-text">STATUS: EOF // Awaiting user input...</span>
                    <a href="#contacto" id="init-comm-link" class="comm-link" aria-expanded="false" aria-controls="contacto-form"><span class="menu-key">[Y]</span> INITIATE_MAIL_PROTOCOL <span class="cursor">_</span></a>
                    <p class="contacto-copy">Escribime. Llega a mi correo y respondo yo.</p>
                    <form id="contacto-form" class="contacto-form" novalidate hidden aria-label="Formulario de contacto">
                        <div class="contacto-campo">
                            <label for="contacto-nombre">NOMBRE</label>
                            <input type="text" id="contacto-nombre" name="nombre" autocomplete="name" required />
                        </div>
                        <div class="contacto-campo">
                            <label for="contacto-mail">MAIL</label>
                            <input type="email" id="contacto-mail" name="mail" autocomplete="email" required />
                        </div>
                        <div class="contacto-campo">
                            <label for="contacto-mensaje">MENSAJE</label>
                            <textarea id="contacto-mensaje" name="mensaje" rows="4" required></textarea>
                        </div>
                        <div class="contacto-trampa" aria-hidden="true">
                            <label for="contacto-empresa">Dejar vacío</label>
                            <input type="text" id="contacto-empresa" name="empresa" tabindex="-1" autocomplete="off" />
                        </div>
                        <button type="submit" class="comm-link contacto-submit">[ENVIAR] &rarr;</button>
                        <p class="contacto-status" id="contacto-status" aria-live="polite"></p>
                    </form>
                </div>
            </div>
        </footer>
    </div>

    <VolverArriba />

    <script is:inline>
        (function () {
            var commLink = document.getElementById('init-comm-link');
            var form = document.getElementById('contacto-form');
            if (!commLink || !form) return;

            function abrirForm() {
                form.hidden = false;
                commLink.setAttribute('aria-expanded', 'true');
            }

            function cerrarForm() {
                form.hidden = true;
                commLink.setAttribute('aria-expanded', 'false');
            }

            commLink.addEventListener('click', function (e) {
                e.preventDefault();
                if (form.hidden) {
                    abrirForm();
                    var primerCampo = document.getElementById('contacto-nombre');
                    if (primerCampo) primerCampo.focus();
                } else {
                    cerrarForm();
                }
            });

            if (window.location.hash === '#contacto') {
                abrirForm();
            }

            var status = document.getElementById('contacto-status');
            var boton = form.querySelector('.contacto-submit');

            function mostrarFallback() {
                status.innerHTML = '[!] No pude enviar. Escribime a <a href="mailto:hola@fonchi.com.ar">hola@fonchi.com.ar</a>';
                status.className = 'contacto-status err';
            }

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                var datos = {
                    nombre: form.nombre.value,
                    mail: form.mail.value,
                    mensaje: form.mensaje.value,
                    empresa: form.empresa.value,
                };
                status.textContent = 'ENVIANDO_';
                status.className = 'contacto-status';
                boton.disabled = true;

                fetch('/api/contacto', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(datos),
                })
                    .then(function (r) {
                        return r.json().catch(function () { return {}; }).then(function (data) {
                            return { ok: r.ok, data: data };
                        });
                    })
                    .then(function (result) {
                        boton.disabled = false;
                        if (result.ok) {
                            status.textContent = '[OK] RECIBIDO. TE RESPONDO YO.';
                            status.className = 'contacto-status ok';
                            form.reset();
                        } else {
                            mostrarFallback();
                        }
                    })
                    .catch(function () {
                        boton.disabled = false;
                        mostrarFallback();
                    });
            });
        })();
    </script>
</body>
</html>

<style>
    /* Design System Fonchi — SOURCE Surface */
    :root {
        --negro-profundo: #0c0e0d;
        --negro-registro: #101311;
        --filete: #1d2320;
        --gris-tenue: #5a645d;
        --gris-medio: #959e98;
        --gris-texto: #e4e8e5;
        --blanco-titular: #ffffff;
        --senal: #e5ac3a;

        --font-lectura: 'Spectral', Georgia, 'Times New Roman', serif;
        --font-registro: 'JetBrains Mono', ui-monospace, SFMono-Regular, Consolas, monospace;

        --tr-display: -0.03em;
        --tr-sello: 0.14em;
        --medida-lectura: 680px;
    }

    * {
        box-sizing: border-box;
        border-radius: 0 !important; /* Regla de oro: cero redondeos */
    }

    ::selection {
        background: var(--senal);
        color: var(--negro-profundo);
    }

    body {
        margin: 0;
        padding: 0;
        background-color: var(--negro-profundo);
        color: var(--gris-texto);
        font-family: var(--font-lectura);
        font-weight: 300;
        font-size: 17px;
        line-height: 1.68;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
    }

    .system-hud {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        font-family: var(--font-registro);
        font-size: 11px;
        letter-spacing: var(--tr-sello);
        color: var(--senal);
        border-bottom: 1px solid var(--filete);
        padding: 10px 24px;
        background: rgba(12, 14, 13, 0.96);
        text-transform: uppercase;
        z-index: 100;
        box-sizing: border-box;
    }

    .container {
        max-width: 860px;
        margin: 0 auto;
        padding: 96px 28px 96px 28px;
    }

    header {
        margin-bottom: 56px;
    }

    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .brand-conjunto {
        display: inline-flex;
        align-items: baseline;
        gap: 24px;
        margin-bottom: 34px;
        text-decoration: none;
    }

    .brand-conjunto:hover .brand-wordmark {
        color: var(--senal);
    }

    .brand-signo {
        height: 56px;
        width: auto;
        display: block;
        flex: none;
    }

    /* Construcción secuencial de la F: Los 12 bloques entran de izquierda a derecha en cascada y quedan fijos */
    .banda-signo {
        opacity: 0;
        transform: translateX(-35px);
        will-change: transform, opacity;
        animation: construir-banda 0.38s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        animation-delay: calc(var(--i) * 32ms);
    }

    @keyframes construir-banda {
        0% {
            opacity: 0;
            transform: translateX(-35px);
        }
        100% {
            opacity: var(--final-op);
            transform: translateX(0);
        }
    }

    /* La palabra "fonchi" permanece 100% estática */
    .brand-wordmark {
        font-family: var(--font-lectura);
        font-weight: 600;
        font-size: 44px;
        line-height: 1;
        letter-spacing: var(--tr-display);
        color: var(--blanco-titular);
    }

    .subtitle {
        font-family: var(--font-registro);
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--senal);
        margin: 0;
    }

    .cursor {
        display: inline-block;
        animation: blink 1s step-end infinite;
        background-color: var(--senal);
        color: var(--negro-profundo);
        padding: 0 4px;
        margin-left: 4px;
    }

    @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
    }

    .log-grid {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .node {
        border-top: 1px solid var(--filete);
        padding: 38px 0 30px 0;
    }

    .node-id {
        font-family: var(--font-registro);
        font-size: 11px;
        letter-spacing: var(--tr-sello);
        color: var(--senal);
        display: block;
        margin-bottom: 22px;
        text-transform: uppercase;
    }

    .node h2 {
        font-family: var(--font-lectura);
        font-weight: 200;
        font-size: 34px;
        line-height: 1.1;
        letter-spacing: var(--tr-display);
        margin: 0 0 24px 0;
        color: var(--blanco-titular);
        text-wrap: pretty;
    }

    .node h2 a {
        color: inherit;
        text-decoration: none;
    }

    .node h2 a:hover,
    .node h2 a:focus-visible {
        color: var(--senal);
        text-decoration: underline;
        text-underline-offset: 0.25em;
    }

    /* Formato de HTML interno desde Markdown */
    :global(.node-content p) {
        font-family: var(--font-lectura);
        font-weight: 300;
        font-size: 17px;
        line-height: 1.68;
        margin: 0 0 24px 0;
        color: var(--gris-texto);
        max-width: var(--medida-lectura);
    }

    :global(.node-content blockquote) {
        margin: 0 0 24px 0;
        padding: 16px 20px;
        background: var(--negro-registro);
        border-left: 3px solid var(--senal);
        font-family: var(--font-lectura);
        font-weight: 300;
        font-size: 17px;
        color: var(--blanco-titular);
    }

    :global(.node-content ul), :global(.node-content ol) {
        font-family: var(--font-lectura);
        font-weight: 300;
        font-size: 17px;
        line-height: 1.68;
        margin: 0 0 24px 0;
        padding-left: 24px;
        color: var(--gris-texto);
    }

    :global(.node-content a) {
        color: var(--senal);
        text-decoration: none;
        border-bottom: 1px solid var(--senal);
    }

    :global(.node-content a:hover) {
        border-bottom-width: 2px;
    }

    :global(.node-content strong) {
        font-weight: 600;
        color: var(--blanco-titular);
    }

    :global(.node-content code) {
        font-family: var(--font-registro);
        font-size: 14px;
        color: var(--senal);
        background: var(--negro-registro);
        padding: 2px 6px;
    }

    .eof {
        font-family: var(--font-registro);
        font-size: 11px;
        letter-spacing: var(--tr-sello);
        color: var(--gris-tenue);
        display: block;
        margin-top: 24px;
    }

    .system-footer {
        margin-top: 72px;
        border-top: 1px solid var(--filete);
        padding-top: 36px;
        color: var(--gris-tenue);
    }

    .eof-log {
        display: block;
        margin-bottom: 32px;
        font-family: var(--font-registro);
        font-size: 11px;
        letter-spacing: var(--tr-sello);
        color: var(--gris-tenue);
    }

    .whois-block {
        background-color: var(--negro-registro);
        border: 1px solid var(--filete);
        padding: 28px;
    }

    .prompt-line {
        font-family: var(--font-registro);
        font-size: 12px;
        color: var(--senal);
        display: block;
        margin-bottom: 18px;
    }

    .whois-block p {
        margin: 0 0 8px 0;
        font-family: var(--font-registro);
        font-size: 13px;
        color: var(--gris-medio);
    }

    .action-menu {
        margin-top: 28px;
        border-top: 1px dashed var(--filete);
        padding-top: 20px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .dim-text {
