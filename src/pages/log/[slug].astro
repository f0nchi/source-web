---
import VolverArriba from '../../components/VolverArriba.astro';
export function getStaticPaths() {
    // Texto crudo por slug: la meta description de cada entrada sale de su primer párrafo real.
    const raws = Object.fromEntries(
        Object.entries(import.meta.glob('../../logs/*.md', { query: '?raw', import: 'default', eager: true }))
            .map(([path, raw]) => [path.split('/').pop()?.replace(/\.md$/, '') || '', raw as string])
    );
    const modules = Object.entries(import.meta.glob('../../logs/*.md', { eager: true }))
        .map(([path, log]: [string, any]) => ({
            ...log,
            slug: path.split('/').pop()?.replace(/\.md$/, '') || '',
        }))
        .sort((a, b) => new Date(b.frontmatter?.date).valueOf() - new Date(a.frontmatter?.date).valueOf());

    return modules.map((log, index) => ({
        params: { slug: log.slug },
        props: {
            log,
            rawText: raws[log.slug] || '',
            newer: index > 0 ? modules[index - 1] : null,
            older: index < modules.length - 1 ? modules[index + 1] : null,
        },
    }));
}

const { log, newer, older, rawText } = Astro.props;
const Content = log.default;
const canonical = new URL(`/log/${log.slug}/`, Astro.site);
const cuerpoPlano = (rawText || '')
    .replace(/^---[\s\S]*?---/, '')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[#>*_`]/g, '')
    .trim();
const primerParrafo = (cuerpoPlano.split(/\n\s*\n/)[0] || '').replace(/\s+/g, ' ').trim();
const description = primerParrafo.length >= 50
    ? (primerParrafo.length > 155
        ? primerParrafo.slice(0, 155).replace(/\s+\S*$/, '') + '…'
        : primerParrafo)
    : `${log.frontmatter?.title}, una entrada del registro público de Fonchi Fontecoba.`;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{log.frontmatter?.title} // SOURCE</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Spectral & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Spectral:ital,wght@0,200;0,300;0,400;0,600;1,300&display=swap" rel="stylesheet">

    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: log.frontmatter?.title,
        datePublished: log.frontmatter?.date,
        dateModified: log.frontmatter?.date,
        mainEntityOfPage: canonical.toString(),
        author: {
            '@type': 'Person',
            '@id': 'https://www.fonchi.com.ar/#person',
            name: 'Fonchi Fontecoba',
        },
    })}></script>
</head>
<body>
    <div class="system-hud">
        [HOST: FONCHI] || [LAYER: SOURCE] || [STATUS: {log.frontmatter?.status || 'STATUS_OK'}]
    </div>

    <main class="container">
        <nav class="back" aria-label="Navegación principal">
            <a href="/">&larr; VOLVER_A_SOURCE</a>
        </nav>

        <article class="node">
            <p class="node-id">&gt;&gt; {log.frontmatter?.date} // {log.frontmatter?.status || 'STATUS_OK'}</p>
            <h1>{log.frontmatter?.title}</h1>
            <div class="node-content">
                <Content />
            </div>
            <span class="eof">[EOF]</span>
        </article>

        <nav class="sequence" aria-label="Registros relacionados">
            {newer ? <a href={`/log/${newer.slug}/`}>&larr; MÁS_NUEVO</a> : <span></span>}
            {older ? <a href={`/log/${older.slug}/`}>MÁS_ANTERIOR &rarr;</a> : <span></span>}
        </nav>
    </main>

    <VolverArriba />
</body>
</html>

<style>
    /* Design System Fonchi — Single Log Page */
    :root {
        --negro-profundo: #0c0e0d;
        --negro-registro: #101311;
        --filete: #1d2320;
        --gris-tenue: #5a645d;
        --gris-medio: #959e98;
        --gris-texto: #e4e8e5;
        --blanco-titular: #ffffff;
        --senal: #e5ac3a;

        --font-lectura: 'Spectral', Georgia, 'Times New Roman', serif;
        --font-registro: 'JetBrains Mono', ui-monospace, SFMono-Regular, Consolas, monospace;

        --tr-display: -0.03em;
        --tr-sello: 0.14em;
        --medida-lectura: 680px;
    }

    * {
        box-sizing: border-box;
        border-radius: 0 !important; /* Regla de oro: cero redondeos */
    }

    ::selection {
        background: var(--senal);
        color: var(--negro-profundo);
    }

    body {
        margin: 0;
        background: var(--negro-profundo);
        color: var(--gris-texto);
        font-family: var(--font-lectura);
        font-weight: 300;
        font-size: 17px;
        line-height: 1.68;
        -webkit-font-smoothing: antialiased;
    }

    .system-hud {
        position: fixed;
        inset: 0 0 auto;
        box-sizing: border-box;
        z-index: 10;
        padding: 10px 24px;
        border-bottom: 1px solid var(--filete);
        background: rgba(12, 14, 13, 0.96);
        color: var(--senal);
        font-family: var(--font-registro);
        font-size: 11px;
        letter-spacing: var(--tr-sello);
    }

    .container {
        max-width: 860px;
        margin: 0 auto;
        padding: 96px 28px 96px 28px;
    }

    a {
        color: var(--senal);
        text-decoration: none;
    }

    /* Los links adentro del contenido markdown quedan fuera del scope de Astro:
       se estilan global para que lleven la señal, nunca el azul default. */
    .node-content :global(a) {
        color: var(--senal);
        text-decoration: none;
        border-bottom: 1px solid var(--senal);
    }

    .node-content :global(a:hover) {
        border-bottom-width: 2px;
    }

    a:hover, a:focus-visible {
        text-decoration: underline;
        text-underline-offset: 0.25em;
    }

    .back {
        margin-bottom: 44px;
        font-family: var(--font-registro);
        font-size: 12px;
        letter-spacing: var(--tr-sello);
    }

    .node {
        padding: 38px 0 30px 0;
        border-top: 1px solid var(--filete);
        border-bottom: 1px solid var(--filete);
    }

    .node-id,
    .eof {
        font-family: var(--font-registro);
        font-size: 11px;
        letter-spacing: var(--tr-sello);
        color: var(--gris-tenue);
    }

    .node-id {
        color: var(--senal);
        margin-bottom: 22px;
    }

    h1 {
        margin: 0 0 32px 0;
        color: var(--blanco-titular);
        font-family: var(--font-lectura);
        font-weight: 200;
        font-size: clamp(2.2rem, 5vw, 3.4rem);
        line-height: 1.06;
        letter-spacing: var(--tr-display);
        text-wrap: pretty;
    }

    .node-content :global(p) {
        font-family: var(--font-lectura);
        font-weight: 300;
        font-size: 17px;
        line-height: 1.68;
        margin: 0 0 24px 0;
        color: var(--gris-texto);
        max-width: var(--medida-lectura);
    }

    .node-content :global(blockquote) {
        margin: 0 0 24px 0;
        padding: 16px 20px;
        background: var(--negro-registro);
        border-left: 3px solid var(--senal);
        font-family: var(--font-lectura);
        font-weight: 300;
        font-size: 17px;
        color: var(--blanco-titular);
    }

    .node-content :global(ul), .node-content :global(ol) {
        font-family: var(--font-lectura);
        font-weight: 300;
        font-size: 17px;
        line-height: 1.68;
        margin: 0 0 24px 0;
        padding-left: 24px;
        color: var(--gris-texto);
    }

    .node-content :global(strong) {
        font-weight: 600;
        color: var(--blanco-titular);
    }

    .node-content :global(code) {
        font-family: var(--font-registro);
        font-size: 14px;
        color: var(--senal);
        background: var(--negro-registro);
        padding: 2px 6px;
    }

    .eof {
        display: block;
        margin-top: 24px;
    }

    .sequence {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 36px;
        font-family: var(--font-registro);
        font-size: 12px;
        letter-spacing: var(--tr-sello);
    }

    .sequence :global(a:last-child) {
        text-align: right;
    }
</style>
