<a href="#" id="volver-arriba" aria-label="Volver arriba">
    <svg viewBox="6 8 52 48" role="img" aria-hidden="true">
        <rect x="28" y="8" width="30" height="4" fill="var(--senal)" opacity="1"></rect>
        <rect x="26" y="12" width="30" height="4" fill="var(--senal)" opacity="1"></rect>
        <rect x="24" y="16" width="8" height="4" fill="var(--senal)" opacity="0.92"></rect>
        <rect x="22" y="20" width="8" height="4" fill="var(--senal)" opacity="0.84"></rect>
        <rect x="20" y="24" width="8" height="4" fill="var(--senal)" opacity="0.76"></rect>
        <rect x="18" y="28" width="20" height="4" fill="var(--senal)" opacity="0.68"></rect>
        <rect x="16" y="32" width="20" height="4" fill="var(--senal)" opacity="0.60"></rect>
        <rect x="14" y="36" width="8" height="4" fill="var(--senal)" opacity="0.52"></rect>
        <rect x="12" y="40" width="8" height="4" fill="var(--senal)" opacity="0.44"></rect>
        <rect x="10" y="44" width="8" height="4" fill="var(--senal)" opacity="0.36"></rect>
        <rect x="8" y="48" width="8" height="4" fill="var(--senal)" opacity="0.28"></rect>
        <rect x="6" y="52" width="8" height="4" fill="var(--senal)" opacity="0.20"></rect>
    </svg>
</a>

<style>
    #volver-arriba {
        position: fixed;
        bottom: 26px;
        right: 26px;
        display: block;
        padding: 10px 12px;
        background: var(--negro-registro, #101311);
        border: 1px solid var(--filete, #1d2320);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s ease, border-color 0.2s ease;
        z-index: 90;
    }

    #volver-arriba svg {
        height: 24px;
        width: auto;
        display: block;
    }

    #volver-arriba.visible {
        opacity: 1;
        pointer-events: auto;
    }

    #volver-arriba:hover {
        border-color: var(--senal, #e5ac3a);
    }
</style>

<script is:inline>
    (function () {
        var boton = document.getElementById('volver-arriba');
        if (!boton) return;
        var actualizar = function () {
            boton.classList.toggle('visible', window.scrollY > 400);
        };
        window.addEventListener('scroll', actualizar, { passive: true });
        actualizar();
        boton.addEventListener('click', function (e) {
            e.preventDefault();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    })();
</script>
