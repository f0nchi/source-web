---
// Rótulo visible de la sección de ensayos, centralizado acá: renombrarla es
// tocar esta única constante. Las URLs (/ensayos/) no dependen de este valor.
export const SECCION_FIRMADA = 'ENSAYOS';
// El menú nombra las dos partes del sitio por lo que son y marca en cuál está quien lee.
const { actual = '' } = Astro.props;
---

<nav class="site-nav" aria-label="Navegación principal">
    <a href="/" class:list={[{ actual: actual === 'hice' }]} aria-current={actual === 'hice' ? 'page' : undefined}>LO_QUE_HICE</a>
    <a href="/ensayos/" class:list={[{ actual: actual === 'pienso' }]} aria-current={actual === 'pienso' ? 'page' : undefined}>LO_QUE_PIENSO</a>
    <a href="/#contacto">CONTACTO</a>
</nav>

<style>
    .site-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 28px;
        margin-bottom: 44px;
        font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Consolas, monospace;
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .site-nav a {
        color: var(--gris-medio, #959e98);
        text-decoration: none;
        padding-bottom: 6px;
        border-bottom: 1px solid transparent;
    }

    .site-nav a.actual {
        color: var(--senal, #e5ac3a);
        border-bottom-color: var(--senal, #e5ac3a);
    }

    .site-nav a:hover,
    .site-nav a:focus-visible {
        color: var(--senal, #e5ac3a);
    }
</style>
