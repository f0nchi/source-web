{
  "name": "source-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "npm run build && wrangler dev --profile fonchi-pilot",
    "test": "node --test",
    "check": "npm run test && npm run build && npm run cf:dry-run",
    "cf:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "npm run build && wrangler deploy --profile fonchi-pilot && npm run indexnow",
    "deploy:builds": "node scripts/deploy-builds.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "http-cache-semantics": "4.3.0"
  }
}
